{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client", "vite-plugin-pwa/client", "node"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"],
      "react-native": ["./src/rn/react-native.tsx"],
      "react-native-svg": ["./src/rn/react-native-svg.tsx"],
      "@react-native-async-storage/async-storage": ["./src/rn/async-storage.ts"],
      "expo-haptics": ["./src/rn/expo-haptics.ts"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
